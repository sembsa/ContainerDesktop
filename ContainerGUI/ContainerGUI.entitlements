<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app spawns the external `container` CLI, so it cannot run inside the
	     App Sandbox. Distribution is Developer ID + notarization (not Mac App Store). -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
