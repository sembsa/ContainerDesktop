{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "containerdesktop-appcast",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "containerdesktop-installs",
      // Filled in by `wrangler d1 create containerdesktop-installs`.
      "database_id": "37c8f721-5f53-48ac-bbc1-b6c224dad818"
    }
  ]
}
